          "name": "List Detection 360 reports for a specific type of detection misclassification.",
          "request": {
            "name": "List Detection 360 reports for a specific type of detection misclassification.",
            "description": {
              "content": "Get a list of Detection 360 reports that you have submitted and view corresponding details for each case, including report summaries, statuses, message analyses, and more.",
