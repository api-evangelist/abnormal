    {
      "id": "091648d9-e924-49bc-a382-68f5695055ea",
      "name": "Tokens",
      "description": {
        "content": "API to manage SOAR API tokens",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "75d7fba6-8591-4002-86fe-5538d09df4bb",
          "name": "Get a list of API tokens for the authenticated customer",
          "request": {
            "name": "Get a list of API tokens for the authenticated customer",
            "description": {
              "content": "Fetch all API tokens for the authenticated customer from the Go Token Management Service.\n\nThis endpoint retrieves tokens with response format containing:\n- token_id: UUID of the token\n- name: Token name\n- version: Token version (v1 or v2)\n- status: Token status (active, expired, revoked)\n- created_at: ISO 8601 creation timestamp\n- expires_at: ISO 8601 expiration timestamp\n- permissions: List of permission strings (scope)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "soar",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of tokens to return (1-200, default 50)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Pagination offset (default 0)"
                },
                {
                  "disabled": false,
                  "key": "show_all",
                  "value": "<boolean>",
                  "description": "Include expired/revoked tokens (default false)"
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Sort field: created_at, -created_at, expires_at, -expires_at"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Returns test data if set to `True`",
                "key": "mock-data",
                "value": "False"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "ca976fba-2115-4486-8969-e7f5b5d3d228",
              "name": "A list of API tokens for the customer.",
