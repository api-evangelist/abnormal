{
  "opencollection": "1.0.0",
  "info": {
    "name": "Abnormal Security Client Employee Insights API",
    "version": "1.4.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Employee Insights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get employee information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.abnormalplatform.com/v1/employee/:email_address",
            "headers": [
              {
                "name": "mock-data",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "email_address",
                "value": "",
                "type": "path",
                "description": "Email address of the employee you want to retrieve data for"
              }
            ]
          },
          "docs": "Get employee information"
        },
        {
          "info": {
            "name": "Get employee identity analysis (Genome) data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.abnormalplatform.com/v1/employee/:email_address/identity",
            "headers": [
              {
                "name": "mock-data",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "email_address",
                "value": "",
                "type": "path",
                "description": "Email address of the employee you want to retrieve data for"
              }
            ]
          },
          "docs": "Get employee identity analysis (Genome) data"
        },
        {
          "info": {
            "name": "Get employee login information for last 30 days in csv format",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.abnormalplatform.com/v1/employee/:email_address/logins",
            "headers": [
              {
                "name": "mock-data",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "email_address",
                "value": "",
                "type": "path",
                "description": "Email address of the employee you want to retrieve data for"
              }
            ]
          },
          "docs": "Get employee login information for last 30 days in csv format"
        }
      ]
    }
  ],
  "bundled": true
}